{
	"license": "Apache-2.0",
	"name": "w2v-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "husky && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:run": "vitest run",
		"type-drift:check": "bun scripts/type-drift-check.ts",
		"ci:verify": "bun run check && bun run type-drift:check && bun run lint"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/diff": "^8.0.0",
		"axe-core": "^4.14.1",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^20.14.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.1",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.8",
		"diff": "^9.0.0",
		"fflate": "^0.8.3",
		"http-proxy-3": "^1.23.3",
		"keycloak-js": "^26.2.5",
		"svelte-dnd-action": "^0.9.80",
		"wavesurfer.js": "^7.12.12"
	},
	"lint-staged": {
		"*.{ts,js,svelte,css,html,json,md,yaml,yml}": "prettier --write"
	}
}
