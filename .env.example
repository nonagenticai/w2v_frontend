# w2v frontend environment variables
# Copy to .env.local for local dev.

# Backend API base (used server-side; browser requests use the SvelteKit /api proxy)
VITE_API_URL=http://localhost:6300

# Keycloak authentication
VITE_KEYCLOAK_URL=https://auth.nonagentic.ai
VITE_KEYCLOAK_REALM=portal
VITE_KEYCLOAK_CLIENT_ID=w2v-frontend

# Optional license token for local dev / smoke tests. When set, the API
# client sends `X-Tenant-Id: Bearer <license_token>` (the backend's
# documented contract — see /Users/mini1/Movies/w2v/CLAUDE.md "Auth —
# license token + tenant forwarding"). In production the SPA's Keycloak JWT
# in `Authorization` is sufficient and this should stay unset.
# VITE_LICENSE_TOKEN=

# Optional WebSocket override (otherwise derived from window.location)
# VITE_W2V_WS_URL=ws://localhost:6300

# Dev escape hatch — skips Keycloak entirely and uses a mock dev user
# VITE_AUTH_BYPASS=true
